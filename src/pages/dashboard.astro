---
import Layout from "~/layouts/PageLayout.astro";
---

<Layout>

<section class="mx-auto max-w-5xl px-6 py-20">

  <h1 class="text-4xl font-black text-white">
    My Account
  </h1>

  <p class="mt-3 text-gray-400">
    Welcome back.
  </p>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">

  <div class="rounded-2xl border border-white/10 bg-[#111111] p-8">

    <h2 class="text-xl font-semibold text-white">
      AI Guides
    </h2>

    <p class="mt-3 text-gray-400">
      Browse your free and premium AI Guides.
    </p>

    <a
      href="/ai-guides"
      class="mt-6 inline-flex rounded-xl bg-[#B71C1C] px-5 py-3 font-semibold text-white transition hover:bg-[#991B1B]"
    >
      Browse AI Guides
    </a>

  </div>

  <div class="rounded-2xl border border-white/10 bg-[#111111] p-8">

    <h2 class="text-xl font-semibold text-white">
      Account
    </h2>

    <p
      id="user-email"
      class="mt-4 text-gray-400"
    >
      Loading account...
    </p>

    <button
      id="logout"
      class="mt-8 rounded-xl bg-[#B71C1C] px-5 py-3 font-semibold text-white transition hover:bg-[#991B1B]"
    >
      Sign Out
    </button>

  </div>

</div>

</section>

<script type="module">
  import { supabase } from "/src/lib/supabase.ts";

  const {
  data: { session },
} = await supabase.auth.getSession();

if (!session) {
  window.location.replace("/account");
}

document.getElementById("user-email").textContent =
  `Signed in as ${session.user.email}`;

document
  .getElementById("logout")
  ?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.replace("/");
  });
</script>