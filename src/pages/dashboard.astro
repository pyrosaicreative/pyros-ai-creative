---
import Layout from '~/layouts/PageLayout.astro';
import DashboardClient from '~/components/DashboardClient.tsx';
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <h1 class="text-3xl font-semibold text-white">My Account</h1>

    <div class="mt-6 grid items-start gap-5 lg:grid-cols-2">
      <!-- AI Guides -->

      <div class="rounded-md border border-white/10 bg-[#111111] p-6 sm:p-7">
        <h2 class="text-xl font-semibold text-white">AI Guides</h2>

        <p class="mt-3 text-gray-400">Access free AI filmmaking guides and practical workflows.</p>

        <a
          href="/ai-guides"
          class="mt-6 inline-flex rounded-md bg-[#B08A57] px-5 py-3 font-semibold text-[#090909] transition hover:bg-[#C6A16A]"
        >
          Browse AI Guides
        </a>
      </div>

      <!-- Account -->

      <div class="rounded-md border border-white/10 bg-[#111111] p-6 sm:p-7">
        <h2 class="text-xl font-semibold text-white">Account</h2>

        <DashboardClient client:load />
      </div>
    </div>
  </section>
</Layout>
