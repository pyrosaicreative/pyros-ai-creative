---
import Layout from "~/layouts/PageLayout.astro";
import DashboardClient from "~/components/DashboardClient.tsx";
---

<Layout>

  <section class="mx-auto max-w-6xl px-6 pt-8 pb-16">

    <h1 class="text-4xl font-bold text-white">
      Dashboard
    </h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">

      <!-- AI Guides -->

      <div class="rounded-2xl border border-white/10 bg-[#111111] p-8">

        <h2 class="text-xl font-semibold text-white">
          AI Guides
        </h2>

        <p class="mt-3 text-gray-400">
          Browse your free and premium AI Guides.
        </p>

        <a
          href="/ai-guides"
          class="mt-6 inline-flex rounded-xl bg-[#8F6B3B] px-5 py-3 font-semibold text-white transition hover:bg-[#9A7A49]"
        >
          Browse AI Guides
        </a>

      </div>

      <!-- Account -->

      <div class="rounded-2xl border border-white/10 bg-[#111111] p-8">

        <h2 class="text-xl font-semibold text-white">
          Account
        </h2>

        <DashboardClient client:load />

      </div>

    </div>

  </section>

</Layout>