---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  metadata={{
    title: 'Check Your Email | PYROS AI Creative',
    description: 'Check your email to confirm your PYROS AI Creative newsletter subscription.',
  }}
>
  <main class="min-h-screen bg-[#090909] text-white">

    <!-- Hero -->
    <section class="mx-auto w-full max-w-6xl px-4 pt-6 md:px-6">

      <div class="relative overflow-hidden rounded-sm">

        <!-- Background image -->
        <img
          src="/images/newsletter/newsletter-check-hero.png"
          alt="PYROS AI Creative"
          class="absolute inset-0 h-full w-full object-cover object-center"
        />

        <!-- Dark cinematic overlay -->
        <div class="absolute inset-0 bg-black/70"></div>

        <!-- Content -->
        <div class="relative flex min-h-[620px] items-center justify-center px-6 py-16 text-center md:min-h-[650px]">

          <div class="max-w-3xl">

            <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#B08A57]">
              NEWSLETTER
            </p>

            <h1 class="mt-4 font-serif text-4xl leading-tight text-white md:text-6xl">
              Check your email.
            </h1>

            <div class="mx-auto mt-6 h-px w-12 bg-[#B08A57]"></div>

            <p class="mt-7 text-lg text-gray-100 md:text-xl">
              Almost there.
            </p>

            <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-gray-300 md:text-base">
              We’ve sent you a confirmation email.
              Click <span class="font-medium text-white">“Confirm your subscription”</span>
              in the email to complete your subscription to PYROS AI Creative.
            </p>

            <p class="mt-7 text-[10px] uppercase tracking-[0.2em] text-[#B08A57]">
              AI FILMMAKING • CREATIVE WORKFLOWS • AI GUIDES
            </p>

          </div>

        </div>

      </div>

    </section>

  </main>
</PageLayout>