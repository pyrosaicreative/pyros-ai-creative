

---
import Layout from '~/layouts/PageLayout.astro';
import { lessons } from '~/data/courseLessons';

const nextLessonNumber = String(lessons.length + 1).padStart(2, '0');
---



<Layout metadata={{ title: 'AI Filmmaking: How Cinema Communicates' }}>
  <div class="design-content">
    <section class="course-heading">
      <div class="wrap">
        <div class="breadcrumb">
          <a data-astro-reload href="/">Home</a> /
          <a data-astro-reload href="/courses">Courses</a> / AI Filmmaking: How Cinema Communicates
        </div>

        <div class="eyebrow">
          <span class="dot"></span>Free course · Beginner
        </div>

        <h1>AI Filmmaking: How Cinema Communicates</h1>
        <p class="muted">A foundation in cinematic visual storytelling for creators working with AI.</p>
      </div>
    </section>

    <div class="wrap playlist-layout">
      <!-- MAIN VIDEO PLAYER -->
      <main class="player-column">
        <div class="video-player">
          <iframe
            id="course-player"
            src={`https://www.youtube.com/embed/${lessons[0].videoId}?rel=0`}
            title={`PYROS AI Creative — ${lessons[0].title}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>

        
<div class="video-details">
  <span class="lesson-label" id="current-number">
    LESSON {lessons[0].number}
  </span>

  <h2 id="current-title">{lessons[0].title}</h2>

  <span class="free-label">Free video lesson</span>
</div>


        <!-- OPTIONAL COMPANION GUIDE -->
        <div class="companion-guide" id="companion-guide" hidden>
          <div class="guide-copy">
            <span class="guide-kicker"> OPTIONAL COMPANION RESOURCE </span>

            <h3>9 Camera Shot Sizes — Guide, Prompts & Worksheets</h3>

            <p>
              Go beyond the lesson with a 44-page PDF featuring cinematic examples, AI prompts, a shot list planner, and
              practical worksheets.
            </p>

            <span class="guide-meta"> Premium PDF · 44 pages · $2.99 </span>
          </div>

          <a
            class="guide-button"
            href="https://shop.pyrosaicreative.com/products/9-camera-shot-sizes-ai-filmmaking-guide-prompts-worksheets"
            target="_blank"
            rel="noopener noreferrer"
          >
            Get the Guide · $2.99 ↗
          </a>
        </div>
      </main>

      <!-- VIDEO PLAYLIST -->
      <aside class="playlist-sidebar">
        <div class="playlist-header">
          <h2>Course Playlist</h2>
          <span>{lessons.length} available</span>
        </div>

        

<div class="playlist-items">
  {
    lessons.map((lesson, index) => (
      <button
        class:list={['playlist-item', { active: index === 0 }]}
        type="button"
        data-lesson-index={index}
        data-video-id={lesson.videoId}
        data-title={lesson.title}
        data-number={lesson.number}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span class="playlist-number">{lesson.number}</span>

        <span class="playlist-thumbnail">
          <img
            src={lesson.thumbnail}
            alt={`Thumbnail: ${lesson.title}`}
            loading="lazy"
          />
          <span class="thumbnail-play">▶</span>
        </span>

        <span class="playlist-text">
          <strong>{lesson.title}</strong>
          <small>Free lesson</small>
        </span>
      </button>
    ))
  }

  <!-- AUTOMATIC UPCOMING LESSON -->
  <div class="playlist-item playlist-upcoming">
    <span class="playlist-number">{nextLessonNumber}</span>

    <span class="playlist-thumbnail playlist-placeholder">
      <span class="placeholder-lock">🔒</span>
    </span>

    <span class="playlist-text">
      <strong>Coming soon</strong>
      <small>Upcoming lesson</small>
    </span>
  </div>
</div>


      </aside>
    </div>
  </div>
</Layout>

<script>
  const initializeCoursePlaylist = () => {
    const player = document.querySelector<HTMLIFrameElement>('#course-player');

    const title = document.querySelector<HTMLElement>('#current-title');

    const number = document.querySelector<HTMLElement>('#current-number');

    const companion = document.querySelector<HTMLElement>('#companion-guide');

const buttons = document.querySelectorAll<HTMLButtonElement>('button.playlist-item');


    if (!player || !title || !number || !companion) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const videoId = button.dataset.videoId;
        const videoTitle = button.dataset.title;
        const videoNumber = button.dataset.number;

        if (!videoId || !videoTitle || !videoNumber) return;

        // Switch the YouTube video
        player.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;

        player.title = `PYROS AI Creative — ${videoTitle}`;

        title.textContent = videoTitle;
        number.textContent = `LESSON ${videoNumber}`;

        // Update the selected lesson
        buttons.forEach((item) => {
          item.classList.remove('active');
          item.setAttribute('aria-pressed', 'false');
        });

        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');

        // Show paid guide only for Lesson 2
        companion.hidden = videoNumber !== '02';
      });
    });
  };

  initializeCoursePlaylist();

  document.addEventListener('astro:page-load', initializeCoursePlaylist);
</script>

<style is:global>
  /* COURSE PAGE */

  .pyros-site .course-heading {
    padding: 28px 0 24px;
  }

  .pyros-site .course-heading .eyebrow {
    margin-top: 24px;
  }

  .pyros-site .course-heading h1 {
    margin: 14px 0 12px;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.1;
  }

  .pyros-site .course-heading p {
    max-width: 720px;
  }

  /* MAIN PLAYLIST LAYOUT */

  .pyros-site .playlist-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    align-items: start;
    gap: 30px;
    padding-bottom: 70px;
  }

  .pyros-site .player-column {
    min-width: 0;
  }

  /* VIDEO PLAYER */

  .pyros-site .video-player {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid #ffffff20;
    border-radius: 10px;
    overflow: hidden;
  }

  .pyros-site .video-player iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* VIDEO DETAILS */

  .pyros-site .video-details {
    padding-top: 22px;
  }

  .pyros-site .lesson-label {
    color: #b08a57;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }

  .pyros-site .video-details h2 {
    color: #f5f5f5;
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.35;
    text-transform: none;
    margin: 10px 0;
  }

  .pyros-site .free-label {
    color: #999;
    font-size: 12px;
  }

  /* PLAYLIST SIDEBAR */

  .pyros-site .playlist-sidebar {
    background: #171719;
    border: 1px solid #343235;
    border-radius: 10px;
    overflow: hidden;
    min-width: 0;
  }

  .pyros-site .playlist-header {
    padding: 21px 20px;
    border-bottom: 1px solid #343235;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pyros-site .playlist-header h2 {
    font-family: Inter, Arial, sans-serif;
    font-size: 17px;
    font-weight: 600;
    text-transform: none;
    margin: 0;
    color: #fff;
  }

  .pyros-site .playlist-header > span {
    color: #999;
    font-size: 11px;
  }

  .pyros-site .playlist-items {
    display: flex;
    flex-direction: column;
    padding: 10px;
    gap: 5px;
  }

  /* PLAYLIST ITEMS */

  .pyros-site .playlist-item {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 12px;
    padding: 10px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #eee;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .pyros-site .playlist-item:hover {
    background: #262427;
  }

  .pyros-site .playlist-item.active {
    background: #30271d;
    border-color: #98764a;
  }

  .pyros-site .playlist-item:focus-visible {
    outline: 2px solid #b08a57;
    outline-offset: 2px;
  }

  .pyros-site .playlist-number {
    color: #b08a57;
    font-size: 11px;
    font-weight: 600;
    flex-shrink: 0;
  }

  /* THUMBNAILS */

  .pyros-site .playlist-thumbnail {
    position: relative;
    display: block;
    width: 110px;
    aspect-ratio: 16 / 9;
    background: #222;
    border-radius: 5px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .pyros-site .playlist-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pyros-site .thumbnail-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #0009;
    color: #fff;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 11px;
  }

  .pyros-site .playlist-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .pyros-site .playlist-text strong {
    font-family: Inter, Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    color: #eee;
  }

  .pyros-site .playlist-text small {
    font-size: 11px;
    color: #a6a1a1;
  }

  /* PREMIUM COMPANION GUIDE */

  .pyros-site .companion-guide[hidden] {
    display: none;
  }

  .pyros-site .companion-guide {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
    padding: 22px;
    border: 1px solid #554530;
    background: #191817;
    border-radius: 9px;
  }

  .pyros-site .guide-copy {
    flex: 1;
    min-width: 0;
  }

  .pyros-site .guide-kicker {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #c4a16e;
    font-weight: 600;
  }

  .pyros-site .guide-copy h3 {
    font-family: Inter, Arial, sans-serif;
    font-size: 16px;
    color: #eee;
    line-height: 1.4;
    margin: 10px 0;
    text-transform: none;
  }

  .pyros-site .guide-copy p {
    color: #aaa;
    font-size: 12px;
    line-height: 1.8;
    margin: 0 0 12px;
  }

  .pyros-site .guide-meta {
    color: #c4a16e;
    font-size: 11px;
  }

  .pyros-site .guide-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #b08a57;
    color: #090909;
    border-radius: 4px;
    padding: 13px 17px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
  }

  .pyros-site .guide-button:hover {
    background: #c6a16a;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .pyros-site .playlist-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .pyros-site .playlist-layout {
      gap: 22px;
    }

    .pyros-site .playlist-header {
      padding: 18px;
    }

    .pyros-site .playlist-thumbnail {
      width: 92px;
    }

    .pyros-site .playlist-text strong {
      font-size: 12px;
    }

    .pyros-site .companion-guide {
      flex-direction: column;
      align-items: stretch;
    }

    .pyros-site .guide-button {
      width: 100%;
    }
  }

/* AUTOMATIC UPCOMING LESSON */

.pyros-site .playlist-upcoming {
  opacity: 0.55;
  cursor: default;
  pointer-events: none;
}

.pyros-site .playlist-placeholder {
  display: grid;
  place-items: center;
  background: #252527;
  border: 1px solid #343235;
}

.pyros-site .placeholder-lock {
  font-size: 20px;
  filter: grayscale(1);
}

</style>
