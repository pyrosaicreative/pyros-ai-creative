---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Courses' }}
  ><div class="design-content">
    <section class="page-intro page-hero" style="--page-art:url(/redesign/courses-hero.png)">
      <div class="wrap">
        <div class="breadcrumb"><a data-astro-reload href="/">Home</a> / Courses</div><div class="eyebrow">
          <span class="dot"></span>Learn with intention
        </div><h1>Courses</h1><p>
          Build your filmmaking skills through structured lessons. Explore each course, see what it covers and choose
          your next step.
        </p>
      </div>
    </section><section class="catalog">
      <div class="wrap">
        <div class="feature-course">
          <div class="course-art"></div><div>
            <div class="badges"><span class="badge free">Free course</span><span class="badge">Beginner</span></div><h2>
              AI Filmmaking: How Cinema Communicates
            </h2><p class="muted">
              Understand how films work before you build your own. Begin with visual storytelling, film structure and
              the four elements that shape a cinematic experience.
            </p><p class="notice">First episode: Introduction to Visual Storytelling · Coming soon</p><a
              data-astro-reload
              class="btn"
              href="/courses/ai-filmmaking-basics">Explore the course <span>→</span></a
            >
          </div>
        </div>
      </div>
    </section>
  </div></Layout
>
