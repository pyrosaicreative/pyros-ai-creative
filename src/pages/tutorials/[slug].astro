---
import Layout from '~/layouts/PageLayout.astro';
import Container from '~/components/Pyros/Container.astro';
import TutorialCard from '~/components/Pyros/TutorialCard.astro';
import { tutorials } from '~/data/tutorials';
import { guides } from '~/data/guides';

export function getStaticPaths() {
  return tutorials.map((tutorial) => ({
    params: {
      slug: tutorial.slug,
    },
    props: {
      tutorial,
    },
  }));
}

const { tutorial } = Astro.props;

const guide =
  guides.find(
    (item) => item.id === tutorial.guideId
  ) ?? null;

const relatedTutorials = tutorials.filter(
  (item) =>
    item.slug !== tutorial.slug &&
    item.category === tutorial.category
);

const metadata = {
  title: tutorial.title,
  description: tutorial.description,
};

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: tutorial.title,
  description: tutorial.description,
  thumbnailUrl: `https://pyrosaicreative.com${tutorial.thumbnail}`,
  uploadDate: tutorial.uploadDate,
  embedUrl: `https://www.youtube.com/embed/${tutorial.youtubeId}`,
  url: `https://pyrosaicreative.com/tutorials/${tutorial.slug}`,
};
---

<Layout metadata={metadata}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(videoSchema)}
  />

  <main class="bg-black pb-24">

    <!-- ===================================================== -->
    <!-- VIDEO -->
    <!-- ===================================================== -->

    <section class="pt-5 lg:pt-6">
      <Container>

        <div
          class="mx-auto max-w-2xl overflow-hidden rounded-2xl
                 border border-white/10 bg-[#0D0D0D]
                 shadow-2xl shadow-black/50"
        >

          <div class="aspect-video w-full">

            <iframe
              class="h-full w-full"
              src={`https://www.youtube.com/embed/${tutorial.youtubeId}`}
              title={tutorial.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write;
                     encrypted-media; gyroscope; picture-in-picture;
                     web-share"
              allowfullscreen
            ></iframe>

          </div>

        </div>

      </Container>
    </section>


    <!-- ===================================================== -->
    <!-- YOUTUBE ACTIONS -->
    <!-- ===================================================== -->

    <section class="pt-3 pb-2">
      <Container>

        <div
          class="mx-auto flex max-w-2xl flex-wrap items-center
                 justify-center gap-2"
        >

          <a
            href={`https://www.youtube.com/watch?v=${tutorial.youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full
                   border border-white/10 bg-white/5
                   px-4 py-2 text-xs font-medium text-white/70
                   transition duration-300
                   hover:border-white/20 hover:bg-white/10
                   hover:text-white"
          >
            Watch on YouTube
          </a>

          <a
            href={`https://www.youtube.com/watch?v=${tutorial.youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full
                   border border-white/10 bg-white/5
                   px-4 py-2 text-xs font-medium text-white/70
                   transition duration-300
                   hover:border-white/20 hover:bg-white/10
                   hover:text-white"
          >
            Like the video
          </a>

          <a
            href="https://www.youtube.com/channel/UC52jL2fl7QQh37vjbau2XIg?sub_confirmation=1"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full
                   bg-[#8F6B3B] px-4 py-2
                   text-xs font-semibold text-white
                   transition duration-300
                   hover:bg-[#9A7A49]"
          >
            Subscribe to PYROS
          </a>

        </div>

      </Container>
    </section>


    <!-- ===================================================== -->
    <!-- GUIDE + WHAT YOU'LL LEARN -->
    <!-- ===================================================== -->

    <section class="pt-10">
      <Container>

        <div
          class="mx-auto grid max-w-5xl gap-12
                 lg:grid-cols-2 lg:items-start"
        >

          <!-- ================================================= -->
          <!-- GUIDE -->
          <!-- ================================================= -->

          {
            guide && (

              <div>

                <!-- SECTION LABEL -->

                <p
                  class="text-[10px] font-semibold uppercase
                         tracking-[0.35em] text-[#8F6B3B]"
                >
                  FREE GUIDE
                </p>


                <!-- GUIDE CONTENT -->

                <div class="mt-6 flex gap-6">

                  <!-- COVER -->

                  <button
                    type="button"
                    data-guide-access
                    data-guide-id={guide.id}
                    data-shop-url={guide.shopUrl}
                    aria-label={`Get ${guide.title}`}
                    class="group relative block w-[175px]
                           shrink-0 overflow-hidden rounded-xl
                           shadow-xl shadow-black/40
                           transition duration-300
                           hover:-translate-y-1
                           hover:shadow-2xl hover:shadow-black/60"
                  >

                    <img
                      src={guide.cover}
                      alt={guide.title}
                      width="1055"
                      height="1491"
                      class="block h-auto w-full
                             transition duration-500
                             group-hover:scale-[1.025]"
                    />

                    <!-- COVER HOVER -->

                    <div
                      class="absolute inset-0 flex items-center
                             justify-center
                             bg-black/0 transition duration-300
                             group-hover:bg-black/35"
                    >

                      <span
                        class="translate-y-2 rounded-full
                               bg-[#8F6B3B] px-4 py-2
                               text-[10px] font-semibold text-white
                               opacity-0 transition duration-300
                               group-hover:translate-y-0
                               group-hover:opacity-100"
                      >
                        GET GUIDE
                      </span>

                    </div>

                  </button>


                  <!-- GUIDE INFO -->

                  <div class="flex min-w-0 flex-1 flex-col">

                    <h2
                      class="text-xl font-bold leading-tight
                             tracking-tight text-white"
                    >
                      {guide.title}
                    </h2>

                    <p
                      class="mt-2 text-[10px] font-semibold uppercase
                             tracking-[0.22em] text-[#8F6B3B]"
                    >
                      {guide.workflow}
                    </p>

                    <p
                      class="mt-4 text-sm leading-6 text-white/50"
                    >
                      {guide.description}
                    </p>


                    <!-- META -->

                    <div class="mt-5 flex flex-wrap gap-2">

                      <span
                        class="rounded-full border border-white/10
                               px-3 py-1.5 text-[10px]
                               font-semibold uppercase
                               tracking-wider text-white/50"
                      >
                        PDF
                      </span>

                      <span
                        class="rounded-full border border-white/10
                               px-3 py-1.5 text-[10px]
                               font-semibold uppercase
                               tracking-wider text-white/50"
                      >
                        {guide.pages} PAGES
                      </span>

                    </div>


                    <!-- FREE NOTE -->

                    <p class="mt-4 text-[11px] font-medium text-white/40">
                      Free · No card required
                    </p>


                    <!-- GUIDE BUTTON -->

                    <button
                      type="button"
                      data-guide-access
                      data-guide-id={guide.id}
                      data-shop-url={guide.shopUrl}
                      class="mt-5 inline-flex w-fit
                             items-center rounded-full
                             bg-[#8F6B3B]
                             px-5 py-2.5
                             text-xs font-semibold text-white
                             transition duration-300
                             hover:bg-[#9A7A49]"
                    >
                      Get Free Guide

                      <span class="ml-2 text-white/60">
                        →
                      </span>
                    </button>

                  </div>

                </div>


                <!-- SUPPORT -->

                <div class="mt-8">

                  <p
                    class="text-[10px] font-semibold uppercase
                           tracking-[0.3em] text-[#8F6B3B]"
                  >
                    SUPPORT THE PROJECT
                  </p>

                  <h3 class="mt-2 text-lg font-semibold text-white">
                    Support PYROS AI Creative
                  </h3>

                  <p class="mt-2 max-w-md text-sm leading-6 text-white/45">
                    Help us create more free AI filmmaking guides,
                    tutorials and creative resources.
                  </p>

                  <a
                    href="https://shop.pyrosaicreative.com/pages/contribute"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center
                           text-sm font-semibold text-[#B89563]
                           transition duration-300
                           hover:text-[#C7A56F]"
                  >
                    Contribute
                  </a>

                </div>

              </div>

            )
          }


          <!-- ================================================= -->
          <!-- WHAT YOU'LL LEARN -->
          <!-- ================================================= -->

          <div class="lg:pt-0">

            <p
              class="text-[10px] font-semibold uppercase
                     tracking-[0.35em] text-[#8F6B3B]"
            >
              WHAT YOU'LL LEARN
            </p>

            <p
  class="mt-4 max-w-xl text-sm leading-6 text-white/45"
>
  {tutorial.learnIntro}
</p>


            <!-- CHECKLIST -->

            <div class="mt-7 space-y-5">

              {tutorial.whatYoullLearn.map((item) => (

                <div class="flex items-start gap-4">

                  <div
                    class="mt-0.5 flex h-7 w-7 shrink-0
                           items-center justify-center rounded-full
                           bg-[#8F6B3B]/15"
                  >

                    <svg
                      class="h-3.5 w-3.5 text-[#B89563]"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 5.29a1 1 0 010 1.414l-7.5 7.5a1 1 0 01-1.414 0l-3.5-3.5a1 1 0 111.414-1.414l2.793 2.793 6.793-6.793a1 1 0 011.414 0z"
                        clip-rule="evenodd"
                      />
                    </svg>

                  </div>

                  <div>

                    <h3 class="text-sm font-semibold text-white">
                      {item.title}
                    </h3>

                    <p class="mt-1 text-xs leading-5 text-white/40">
                      {item.description}
                    </p>

                  </div>

                </div>

              ))}

            </div>

          </div>

        </div>

      </Container>
    </section>


    <!-- ===================================================== -->
    <!-- RELATED TUTORIALS -->
    <!-- ===================================================== -->

    {
      relatedTutorials.length > 0 && (

        <section class="pt-20">
          <Container>

            <div class="mx-auto max-w-5xl">

              <div class="mb-8">

                <p
                  class="text-[10px] font-semibold uppercase
                         tracking-[0.3em] text-[#8F6B3B]"
                >
                  KEEP LEARNING
                </p>

                <h2
                  class="mt-3 text-3xl font-black tracking-tight
                         text-white md:text-4xl"
                >
                  Related Tutorials
                </h2>

              </div>

              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

                {relatedTutorials.map((related) => (

                  <TutorialCard
                    title={related.title}
                    image={related.thumbnail}
                    href={`/tutorials/${related.slug}`}
                    badge={related.badge}
                  />

                ))}

              </div>

            </div>

          </Container>
        </section>

      )
    }

  </main>


  <!-- ===================================================== -->
  <!-- AUTHENTICATED GUIDE ACCESS -->
  <!-- ===================================================== -->

  <script>
    import { supabase } from '~/lib/supabase';

    const guideButtons =
      document.querySelectorAll<HTMLButtonElement>(
        '[data-guide-access]'
      );

    guideButtons.forEach((button) => {

      button.addEventListener('click', async () => {

        const shopUrl = button.dataset.shopUrl;

        if (!shopUrl) {
          console.error(
            'Fourthwall guide URL is missing.'
          );
          return;
        }


        /*
         * CHECK PYROS ACCOUNT
         */

        const {
          data: { session },
        } = await supabase.auth.getSession();


        /*
         * ALREADY SIGNED IN
         */

        if (session) {
  window.open(
    shopUrl,
    '_blank',
    'noopener,noreferrer'
  );

  return;
}

const encodedRedirect =
  encodeURIComponent(shopUrl);

window.open(
  `/account?redirect=${encodedRedirect}`,
  '_blank',
  'noopener,noreferrer'
);


        /*
         * SIGN IN / CREATE ACCOUNT FIRST
         */

        const redirect =
          encodeURIComponent(shopUrl);

        window.location.href =
          `/account?redirect=${redirect}`;

      });

    });
  </script>

</Layout>