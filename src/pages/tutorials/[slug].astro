---
import Layout from '~/layouts/PageLayout.astro';
import Container from '~/components/Pyros/Container.astro';
import TutorialCard from '~/components/Pyros/TutorialCard.astro';
import { tutorials } from '~/data/tutorials';

export function getStaticPaths() {
  return tutorials.map((tutorial) => ({
    params: {
      slug: tutorial.slug,
    },
    props: {
      tutorial,
    },
  }));
}

const { tutorial } = Astro.props;

const relatedTutorials = tutorials.filter(
  (item) =>
    item.slug !== tutorial.slug &&
    item.category === tutorial.category
);

const metadata = {
  title: `${tutorial.title} | PYROS AI Creative`,
  description: tutorial.description,
};
---

<Layout metadata={metadata}>

  <main class="bg-black pb-24">

    <!-- ===================================================== -->
    <!-- VIDEO -->
    <!-- ===================================================== -->

    <section class="pt-5 lg:pt-6">

      <Container>

        <div
          class="mx-auto max-w-3xl overflow-hidden rounded-2xl
                 border border-white/10 bg-[#0D0D0D]
                 shadow-2xl shadow-black/50"
        >

          <div class="aspect-video w-full">

            <iframe
              class="h-full w-full"
              src={`https://www.youtube.com/embed/${tutorial.youtubeId}`}
              title={tutorial.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write;
                     encrypted-media; gyroscope; picture-in-picture;
                     web-share"
              allowfullscreen
            ></iframe>

          </div>

        </div>

      </Container>

    </section>


    <!-- ===================================================== -->
    <!-- TUTORIAL HEADER -->
    <!-- ===================================================== -->

    <section class="pt-6 pb-8">

      <Container>

        <div class="mx-auto max-w-3xl">

          <div class="flex items-center gap-2">

            <span
              class="rounded-full border border-white/10 bg-white/5
                     px-3 py-1 text-[10px] font-semibold uppercase
                     tracking-[0.18em] text-white/60"
            >
              {tutorial.category}
            </span>

            <span
              class={`rounded-full px-3 py-1 text-[10px] font-bold ${
                tutorial.badge === 'FREE'
                  ? 'bg-[#27272A] text-white'
                  : 'bg-yellow-500 text-black'
              }`}
            >
              {tutorial.badge}
            </span>

          </div>


          <h1
            class="mt-3 max-w-3xl text-2xl font-black leading-tight
                   tracking-tight text-white
                   md:text-3xl lg:text-[38px]"
          >
            {tutorial.title}
          </h1>


          <p
            class="mt-2 max-w-2xl text-sm leading-6 text-white/50"
          >
            {tutorial.description}
          </p>

        </div>

      </Container>

    </section>


    <!-- ===================================================== -->
    <!-- GUIDE DOWNLOAD -->
    <!-- ===================================================== -->

    <section class="pt-4">

      <Container>

        <div
          class="mx-auto max-w-4xl rounded-3xl border border-white/10
                 bg-[#111111] p-7 shadow-xl shadow-black/30
                 md:p-9"
        >

          <div
            class="flex flex-col gap-7
                   md:flex-row md:items-center md:justify-between"
          >

            <div class="max-w-2xl">

              <p
                class="text-xs font-semibold uppercase tracking-[0.3em]
                       text-[#8F6B3B]"
              >
                FREE GUIDE
              </p>

              <h2
                class="mt-3 text-2xl font-bold text-white md:text-3xl"
              >
                {tutorial.guide.title}
              </h2>

              <p
                class="mt-3 text-sm leading-6 text-white/50 md:text-base"
              >
                Download the complete guide and follow the workflow
                step by step.
              </p>

            </div>


            <button
              type="button"
              data-guide-download
              data-storage-path={tutorial.guide.storagePath}
              class="inline-flex shrink-0 items-center justify-center
                     rounded-xl bg-[#8F6B3B] px-7 py-4
                     text-sm font-semibold text-white
                     transition duration-300
                     hover:bg-[#9A7A49]"
            >
              Download Free Guide
            </button>

          </div>

        </div>

      </Container>

    </section>


    <!-- ===================================================== -->
    <!-- WHAT YOU'LL LEARN -->
    <!-- ===================================================== -->

    <section class="pt-20">

      <Container>

        <div class="mx-auto max-w-4xl">

          <div class="max-w-3xl">

            <p
              class="text-xs font-semibold uppercase tracking-[0.3em]
                     text-[#8F6B3B]"
            >
              WHAT YOU'LL LEARN
            </p>

            <h2
              class="mt-3 text-3xl font-black tracking-tight text-white
                     md:text-4xl"
            >
              Build consistent AI characters from a single reference.
            </h2>

            <p
              class="mt-4 text-base leading-7 text-white/55"
            >
              This tutorial shows a streamlined image workflow for
              creating the same AI character across different images,
              poses and scenes.
            </p>

          </div>


          <div class="mt-8 grid gap-4 md:grid-cols-2">

            <div
              class="rounded-2xl border border-white/10
                     bg-[#111111] p-6"
            >

              <span class="text-sm font-semibold text-[#8F6B3B]">
                01
              </span>

              <h3 class="mt-3 text-lg font-semibold text-white">
                Create a strong character reference
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/45">
                Build a reliable visual foundation that clearly defines
                the identity of your AI character.
              </p>

            </div>


            <div
              class="rounded-2xl border border-white/10
                     bg-[#111111] p-6"
            >

              <span class="text-sm font-semibold text-[#8F6B3B]">
                02
              </span>

              <h3 class="mt-3 text-lg font-semibold text-white">
                Preserve identity across images
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/45">
                Learn how to maintain the character's key facial and
                visual features when creating new images.
              </p>

            </div>


            <div
              class="rounded-2xl border border-white/10
                     bg-[#111111] p-6"
            >

              <span class="text-sm font-semibold text-[#8F6B3B]">
                03
              </span>

              <h3 class="mt-3 text-lg font-semibold text-white">
                Create new poses and scenes
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/45">
                Move beyond a single portrait and generate new images
                while keeping the same character identity.
              </p>

            </div>


            <div
              class="rounded-2xl border border-white/10
                     bg-[#111111] p-6"
            >

              <span class="text-sm font-semibold text-[#8F6B3B]">
                04
              </span>

              <h3 class="mt-3 text-lg font-semibold text-white">
                Build a repeatable workflow
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/45">
                Turn character consistency into a repeatable part of
                your AI filmmaking workflow.
              </p>

            </div>

          </div>

        </div>

      </Container>

    </section>


    <!-- ===================================================== -->
    <!-- RELATED TUTORIALS -->
    <!-- ===================================================== -->

    {
      relatedTutorials.length > 0 && (

        <section class="pt-20">

          <Container>

            <div class="mx-auto max-w-4xl">

              <div class="mb-8">

                <p
                  class="text-xs font-semibold uppercase tracking-[0.3em]
                         text-[#8F6B3B]"
                >
                  KEEP LEARNING
                </p>

                <h2
                  class="mt-3 text-3xl font-black tracking-tight text-white
                         md:text-4xl"
                >
                  Related Tutorials
                </h2>

              </div>


              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

                {relatedTutorials.map((related) => (

                  <TutorialCard
                    title={related.title}
                    image={related.thumbnail}
                    href={`/tutorials/${related.slug}`}
                    badge={related.badge}
                  />

                ))}

              </div>

            </div>

          </Container>

        </section>

      )
    }

  </main>


  <!-- ===================================================== -->
  <!-- AUTHENTICATED GUIDE DOWNLOAD -->
  <!-- ===================================================== -->

  <script>
    import { supabase } from '~/lib/supabase';

    const downloadButton =
      document.querySelector<HTMLButtonElement>(
        '[data-guide-download]'
      );

    downloadButton?.addEventListener('click', async () => {

      const storagePath =
        downloadButton.dataset.storagePath;

      if (!storagePath) {
        console.error('Guide storage path is missing.');
        return;
      }

      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {

        const redirect =
          encodeURIComponent(window.location.pathname);

        window.location.href =
          `/account?redirect=${redirect}`;

        return;
      }

      const { data, error } =
        await supabase.storage
          .from('guides')
          .createSignedUrl(storagePath, 60);

      if (error) {

        console.error(
          'Guide download error:',
          error
        );

        return;
      }

      window.open(
        data.signedUrl,
        '_blank',
        'noopener,noreferrer'
      );

    });
  </script>

</Layout>