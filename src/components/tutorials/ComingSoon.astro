<script>
const form = document.getElementById("newsletter-form");
const email = document.getElementById("newsletter-email");
const button = document.getElementById("newsletter-button");
const message = document.getElementById("newsletter-message");

if (
  form instanceof HTMLFormElement &&
  email instanceof HTMLInputElement &&
  button instanceof HTMLButtonElement &&
  message instanceof HTMLParagraphElement
) {
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    button.disabled = true;
    email.disabled = true;

    button.classList.add("opacity-70");
    button.classList.add("cursor-not-allowed");

    button.textContent = "Joining...";
    message.textContent = "";

    try {
      const response = await fetch("/api/newsletter", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email: email.value,
        }),
      });

      const text = await response.text();

      let data: { success?: boolean; message?: string } = {};

      try {
        data = JSON.parse(text);
      } catch {
        data = { message: text };
      }

      if (response.ok && data.success) {
        message.className =
          "mt-4 text-center text-sm text-green-400";

        message.textContent =
          "You're in! Check your inbox to confirm your subscription.";

        email.value = "";
      } else {
        message.className =
          "mt-4 text-center text-sm text-red-400";

        message.textContent =
          data.message || "Something went wrong.";
      }
    } catch {
      message.className =
        "mt-4 text-center text-sm text-red-400";

      message.textContent =
        "Unable to subscribe. Please try again.";
    }

    button.disabled = false;
    email.disabled = false;

    button.classList.remove("opacity-70");
    button.classList.remove("cursor-not-allowed");

    button.textContent = "Join for Free";
  });
}
</script>