---
import type { Guide } from '~/data/guides';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
---

<article class="group">

  <!-- COVER -->

  <div
    class="overflow-hidden rounded-2xl border border-white/10 bg-[#111111]
           transition-all duration-500
           group-hover:-translate-y-1
           group-hover:border-[#8F6B3B]/50
           group-hover:shadow-2xl
           group-hover:shadow-black/40"
  >

    <button
      type="button"
      data-guide-download
      data-storage-path={guide.storagePath}
      aria-label={`Download ${guide.title}`}
      class="block w-full cursor-pointer text-left"
    >
      <div class="aspect-[210/297] w-full overflow-hidden leading-none">

        <img
          src={guide.cover}
          alt={guide.title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          loading="lazy"
        />

      </div>
    </button>

  </div>


  <!-- INFORMATION -->

  <div class="-mt-3 relative z-10">

    <!-- BADGES + DOWNLOAD -->

    <div class="flex items-center gap-2">

      {guide.type === 'free' ? (
        <span
          class="inline-flex shrink-0 items-center rounded-full
                 border border-emerald-500/30
                 bg-[#090909] px-3 py-2
                 text-[10px] font-semibold uppercase
                 tracking-[0.15em] text-emerald-400"
        >
          Free
        </span>
      ) : (
        <span
          class="inline-flex shrink-0 items-center rounded-full
                 border border-[#8F6B3B]/40
                 bg-[#090909] px-3 py-2
                 text-[10px] font-semibold uppercase
                 tracking-[0.15em] text-[#C9A66B]"
        >
          Premium
        </span>
      )}

      <span
        class="inline-flex shrink-0 items-center rounded-full
               border border-white/10
               bg-[#090909] px-3 py-2
               text-[10px] font-semibold uppercase
               tracking-[0.12em] text-gray-400"
      >
        PDF
        <span class="mx-1.5 text-white/20">•</span>
        {guide.pages} Pages
      </span>

      {guide.type === 'free' ? (

        <button
          type="button"
          data-guide-download
          data-storage-path={guide.storagePath}
          class="inline-flex shrink-0 items-center rounded-full
                 bg-[#8F6B3B] px-3.5 py-2
                 text-[10px] font-semibold uppercase
                 tracking-[0.12em] text-white
                 transition duration-300
                 hover:bg-[#9A7A49]"
        >
          Download
        </button>

      ) : (

        <button
          type="button"
          disabled
          class="inline-flex shrink-0 items-center rounded-full
                 border border-white/10
                 bg-[#090909] px-3.5 py-2
                 text-[10px] font-semibold uppercase
                 tracking-[0.12em] text-gray-500"
        >
          Coming Soon
        </button>

      )}

    </div>


    <!-- TITLE -->

    <h3 class="mt-4 text-xl font-bold leading-tight tracking-tight text-white">
      {guide.title}
    </h3>


    <!-- WORKFLOW -->

    <p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#8F6B3B]">
      {guide.workflow}
    </p>


    <!-- DESCRIPTION -->

<div class="relative mt-3 max-w-md">

  <p
    data-guide-description
    class="text-sm leading-6 text-gray-400"
  >
    {guide.description}
  </p>

  <button
    type="button"
    data-guide-more
    aria-expanded="false"
    class="absolute bottom-0 right-0 hidden
           bg-[#090909] pl-2
           text-[10px] font-semibold uppercase
           tracking-[0.18em] text-[#C9A66B]
           transition duration-300
           hover:text-white"
  >
    <span data-guide-more-label>More →</span>
  </button>

</div>


    <!-- TUTORIAL -->

    {guide.tutorialUrl && (
      <a
        href={guide.tutorialUrl}
        class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#C9A66B] transition duration-300 hover:text-white"
      >
        Watch the Tutorial
        <span aria-hidden="true">→</span>
      </a>
    )}

  </div>

</article>


<script>
  const setupGuideDescriptions = () => {
    const descriptions = document.querySelectorAll<HTMLElement>(
      '[data-guide-description]'
    );

    descriptions.forEach((description) => {
      const moreButton = description.parentElement?.querySelector<HTMLButtonElement>(
        '[data-guide-more]'
      );

      const moreLabel = moreButton?.querySelector<HTMLElement>(
        '[data-guide-more-label]'
      );

      if (!moreButton || !moreLabel) return;

      // Measure the full text BEFORE applying the 3-line limit.
      const fullHeight = description.scrollHeight;

      // Calculate the height of exactly 3 lines.
      const lineHeight = parseFloat(
        window.getComputedStyle(description).lineHeight
      );

      const maxHeight = lineHeight * 3;

      // If the description is longer than 3 lines, show MORE.
      if (fullHeight > maxHeight + 1) {
        description.style.display = '-webkit-box';
        description.style.webkitBoxOrient = 'vertical';
        description.style.webkitLineClamp = '3';
        description.style.overflow = 'hidden';

        moreButton.classList.remove('hidden');

        moreButton.addEventListener('click', () => {
          const expanded =
            moreButton.getAttribute('aria-expanded') === 'true';

          if (expanded) {
            description.style.display = '-webkit-box';
            description.style.webkitBoxOrient = 'vertical';
            description.style.webkitLineClamp = '3';
            description.style.overflow = 'hidden';

            moreButton.setAttribute('aria-expanded', 'false');
            moreLabel.textContent = 'More →';
          } else {
            description.style.display = 'block';
            description.style.webkitLineClamp = 'unset';
            description.style.overflow = 'visible';

            moreButton.setAttribute('aria-expanded', 'true');
            moreLabel.textContent = 'Less ↑';
          }
        });
      }
    });
  };

  setupGuideDescriptions();
</script>