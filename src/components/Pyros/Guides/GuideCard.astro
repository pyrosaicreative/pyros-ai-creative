---
import type { Guide } from '~/data/guides';
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
---

<article class="integrated-guide-card">
  <div class="guide-cover">
    {
      guide.type === 'free' ? (
        <button
          type="button"
          data-guide-access
          data-guide-id={guide.id}
          data-shop-url={guide.shopUrl}
          aria-label={`Get ${guide.title}`}
        >
          <img src={guide.cover} alt={guide.title} loading="lazy" />
        </button>
      ) : (
        <img src={guide.cover} alt={guide.title} loading="lazy" />
      )
    }
  </div>
  <div class="integrated-guide-info">
    <span class="badge free">{guide.type} · PDF · {guide.pages} pages</span>
    <h2>{guide.title}<small>{guide.workflow}</small></h2>
    <div class="guide-description">
      <p data-guide-description>{guide.description}</p><button
        type="button"
        data-guide-more
        aria-expanded="false"
        class="hidden"><span data-guide-more-label>More →</span></button
      >
    </div>
    {
      guide.type === 'free' ? (
        <button class="btn" type="button" data-guide-access data-guide-id={guide.id} data-shop-url={guide.shopUrl}>
          Get guide <span>↗</span>
        </button>
      ) : (
        <span class="btn secondary">Coming soon</span>
      )
    }
    {
      guide.tutorialUrl && (
        <a
          data-astro-reload
          class="text-link"
          href={guide.tutorialUrl.startsWith('/') ? guide.tutorialUrl.replace(/\/$/, '') : guide.tutorialUrl}
        >
          Watch the tutorial <span>↗</span>
        </a>
      )
    }
  </div>
</article>
<script>
  const setupGuideDescriptions = () => {
    const descriptions = document.querySelectorAll<HTMLElement>('[data-guide-description]');

    descriptions.forEach((description) => {
      const moreButton = description.parentElement?.querySelector<HTMLButtonElement>('[data-guide-more]');

      const moreLabel = moreButton?.querySelector<HTMLElement>('[data-guide-more-label]');

      if (!moreButton || !moreLabel) return;

      const fullHeight = description.scrollHeight;

      const lineHeight = parseFloat(window.getComputedStyle(description).lineHeight);

      const maxHeight = lineHeight * 3;

      if (fullHeight > maxHeight + 1) {
        description.style.display = '-webkit-box';
        description.style.webkitBoxOrient = 'vertical';
        description.style.webkitLineClamp = '3';
        description.style.overflow = 'hidden';

        moreButton.classList.remove('hidden');

        moreButton.addEventListener('click', () => {
          const expanded = moreButton.getAttribute('aria-expanded') === 'true';

          if (expanded) {
            description.style.display = '-webkit-box';
            description.style.webkitBoxOrient = 'vertical';
            description.style.webkitLineClamp = '3';
            description.style.overflow = 'hidden';

            moreButton.setAttribute('aria-expanded', 'false');
            moreLabel.textContent = 'More →';
          } else {
            description.style.display = 'block';
            description.style.webkitLineClamp = 'unset';
            description.style.overflow = 'visible';

            moreButton.setAttribute('aria-expanded', 'true');
            moreLabel.textContent = 'Less ↑';
          }
        });
      }
    });
  };

  setupGuideDescriptions();
</script>
