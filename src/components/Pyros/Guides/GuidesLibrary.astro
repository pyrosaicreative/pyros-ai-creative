---
import GuideCard from './GuideCard.astro';
import { guides } from '~/data/guides';
import PageHero from '~/components/Redesign/PageHero.astro';
---

<PageHero
  title="AI Guides"
  kicker="Your creative reference"
  description="Practical guides and resources for AI filmmaking. Sign in to unlock free content."
/>
<div class="design-content">
  <section class="catalog">
    <div class="wrap">
      <div class="toolbar">
        <div class="filters" aria-label="Filter guides">
          <button type="button" data-filter="all" class="guide-filter border-[#8F6B3B] bg-[#8F6B3B] text-white"
            >All</button
          >
          <button type="button" data-filter="free" class="guide-filter border-white/10 bg-white/5 text-gray-300"
            >Free</button
          >
          <button type="button" data-filter="premium" class="guide-filter border-white/10 bg-white/5 text-gray-300"
            >Premium</button
          >
        </div>
      </div>
      <div id="guides-grid" class="integrated-guide-grid">
        <div id="guides-empty" class="hidden col-span-full py-8"><h3>More guides are on the way.</h3></div>
        {
          guides
            .slice()
            .reverse()
            .map((guide) => (
              <div class="guide-item" data-type={guide.type} id={`guide-${guide.id}`}>
                <GuideCard guide={guide} />
              </div>
            ))
        }
      </div>
    </div>
  </section>
</div>
<script>
  import { supabase } from '~/lib/supabase';

  /*
   * FILTERS
   */

  const setupGuideFilters = () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.guide-filter');

    const guideItems = document.querySelectorAll<HTMLElement>('.guide-item');

    const emptyState = document.querySelector<HTMLElement>('#guides-empty');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;

        /*
         * BUTTON STYLE
         */

        filterButtons.forEach((item) => {
          item.classList.remove('border-[#8F6B3B]', 'bg-[#8F6B3B]', 'text-white');

          item.classList.add('border-white/10', 'bg-white/5', 'text-gray-300');
        });

        button.classList.remove('border-white/10', 'bg-white/5', 'text-gray-300');

        button.classList.add('border-[#8F6B3B]', 'bg-[#8F6B3B]', 'text-white');

        /*
         * FILTER GUIDES
         */

        let visibleGuides = 0;

        guideItems.forEach((item) => {
          const type = item.dataset.type;

          if (filter === 'all' || type === filter) {
            item.classList.remove('hidden');

            visibleGuides++;
          } else {
            item.classList.add('hidden');
          }
        });

        /*
         * EMPTY STATE
         */

        if (emptyState) {
          if (visibleGuides === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    });
  };

  /*
   * FREE GUIDE ACCESS
   */

  const setupGuideAccess = () => {
    const guideButtons = document.querySelectorAll<HTMLButtonElement>('[data-guide-access]');

    guideButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const shopUrl = button.dataset.shopUrl;

        if (!shopUrl) {
          console.error('Fourthwall guide URL is missing.');

          return;
        }

        /*
         * CHECK PYROS ACCOUNT
         */

        const {
          data: { session },
        } = await supabase.auth.getSession();

        /*
         * USER ALREADY SIGNED IN
         */

        if (session) {
          window.open(shopUrl, '_blank', 'noopener,noreferrer');

          return;
        }

        const encodedRedirect = encodeURIComponent(shopUrl);

        window.open(`/account?redirect=${encodedRedirect}`, '_blank', 'noopener,noreferrer');

        /*
         * USER NEEDS TO CREATE / SIGN IN TO ACCOUNT
         */

        const redirect = encodeURIComponent(shopUrl);

        window.location.href = `/account?redirect=${redirect}`;
      });
    });
  };

  /*
   * INITIALIZE
   */

  setupGuideFilters();
  setupGuideAccess();
</script>
