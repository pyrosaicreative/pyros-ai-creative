---
interface Props {
  title: string;
  image: string;
  href: string;
  badge?: 'FREE' | 'PREMIUM';
}

const {
  title,
  image,
  href,
  badge = 'FREE',
} = Astro.props;
---

<a
  href={href}
  class="group block overflow-hidden rounded-3xl border border-white/5 bg-[#111]
  shadow-lg shadow-black/40
  transition-all duration-300 ease-out
  hover:border-white/15
  hover:shadow-[0_20px_50px_rgba(0,0,0,0.55)]"
>

  <div class="relative overflow-hidden">

    <img
      src={image}
      alt={title}
      class="block aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>

    <span
      class={`absolute right-4 top-4 rounded-xl px-4 py-2 text-xs font-bold transition-all duration-300 group-hover:brightness-110 ${
        badge === 'FREE'
          ? 'bg-[#27272A] text-white'
          : 'bg-yellow-500 text-black'
      }`}
    >
      {badge}
    </span>

  </div>

  <div class="-mt-px bg-[#111] p-3">

    <h3 class="text-xs font-semibold text-white">
      {title}
    </h3>

  </div>

</a>