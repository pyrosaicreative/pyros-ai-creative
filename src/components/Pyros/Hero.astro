---
import Container from './Container.astro';
---

<section class="hero-home">

  <!-- Background -->
  <img
    src="/images/hero/hero-home.jpg"
    alt="PYROS AI Creative"
    class="absolute inset-0 h-full w-full object-cover object-right"
  />

  <!-- Overlay -->
<div class="absolute inset-0 bg-black/15"></div>

<div
  class="absolute inset-0 bg-gradient-to-r
         from-black/90
         via-black/55
         to-transparent"
></div>

  <!-- Content -->
  <div class="relative z-10 flex h-full items-center">

    <Container>

      <div class="max-w-4xl">

        <h1 class="font-black leading-[0.95] text-white">

          <div class="text-5xl lg:text-[3.8rem]">
            Learn
            <span class="text-[#B71C1C]">AI</span>
            Filmmaking
          </div>

          <div class="mt-4 text-3xl lg:text-[3.2rem]">
            Create
            <span class="text-[#B71C1C]">Cinematic</span>
            Movies
          </div>

        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-300">
          Create cinematic videos, consistent AI characters,
          commercials and short movies using today's most powerful AI tools.
        </p>

      </div>

    </Container>

  </div>

</section>