---
import { supabase } from "~/lib/supabase";
---


<div class="mx-auto w-full max-w-[1400px]">

  <div class="overflow-hidden rounded-3xl border border-white/10 bg-[#111111] shadow-2xl shadow-black/60">

    <div class="grid lg:grid-cols-[44%_56%]">

      <!-- ===================================================== -->
      <!-- LEFT -->
      <!-- ===================================================== -->

      <div class="bg-[#0d0d0d] px-12 py-10">

        <h1 class="text-[2.25rem] font-black leading-[1.05] text-white">

          Welcome to

          <span class="mt-2 block text-[#B71C1C]">
            PYROS AI Creative
          </span>

        </h1>

        <p class="mt-6 max-w-sm text-[15px] leading-7 text-gray-400">

          Join PYROS AI Creative to download free guides,
          unlock AI Guides and access future premium resources.

        </p>

        <div class="mt-10 space-y-5">

          <div class="flex items-center gap-3">

            <span class="text-[#B71C1C]">✓</span>

            <span class="text-[15px] text-gray-300">
              Download free workflow guides
            </span>

          </div>

          <div class="flex items-center gap-3">

            <span class="text-[#B71C1C]">✓</span>

            <span class="text-[15px] text-gray-300">
              Access AI Guides
            </span>

          </div>

          <div class="flex items-center gap-3">

            <span class="text-[#B71C1C]">✓</span>

            <span class="text-[15px] text-gray-300">
              Save your resources
            </span>

          </div>

          <div class="flex items-center gap-3">

            <span class="text-[#B71C1C]">✓</span>

            <span class="text-[15px] text-gray-300">
              Unlock premium content
            </span>

          </div>

        </div>

      </div>

      <!-- ===================================================== -->
      <!-- RIGHT -->
      <!-- ===================================================== -->

      <div class="px-12 py-10">

        <!-- Tabs -->

        <div class="flex rounded-xl bg-[#1b1b1b] p-1">

          <button
            id="signinTab"
            class="flex-1 rounded-lg bg-[#B71C1C] py-2 text-sm font-semibold text-white transition"
          >
            Sign In
          </button>

          <button
            id="signupTab"
            class="flex-1 rounded-lg py-2 text-sm font-semibold text-gray-400 transition"
          >
            Create Account
          </button>

        </div>

        <!-- Email -->

        <div class="mt-8">

          <label
            for="email"
            class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500"
          >
            Email
          </label>

          <input
            id="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            class="h-11 w-full rounded-xl border border-white/10 bg-black px-4 text-[15px] text-white outline-none transition focus:border-[#B71C1C]"
          />

        </div>

        <!-- Password -->

        <div class="mt-5">

          <label
            for="password"
            class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500"
          >
            Password
          </label>

          <input
            id="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            class="h-11 w-full rounded-xl border border-white/10 bg-black px-4 text-[15px] text-white outline-none transition focus:border-[#B71C1C]"
          />

        </div>

        {/* Confirm Password */}

{mode === "signup" && (
  <div className="mt-5">

    <label className="mb-2 block text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500">
      Confirm Password
    </label>

    <div className="relative">

      <input
        type={showConfirmPassword ? "text" : "password"}
        autoComplete="new-password"
        placeholder="••••••••"
        value={confirmPassword}
        onInput={(e) =>
          setConfirmPassword(
            (e.target as HTMLInputElement).value
          )
        }
        className="h-11 w-full rounded-xl border border-white/10 bg-black px-4 pr-12 text-[15px] text-white outline-none transition focus:border-[#B71C1C] focus:ring-2 focus:ring-[#B71C1C]/30"
      />

      <button
        type="button"
        onClick={() =>
          setShowConfirmPassword(!showConfirmPassword)
        }
        className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 transition hover:text-white"
      >
        {showConfirmPassword ? "🙈" : "👁️"}
      </button>

    </div>

  </div>
)}

        <!-- Forgot -->

        <div
          id="forgotPasswordWrapper"
          class="mt-3 text-right"
        >

          <button
            type="button"
            class="text-xs text-gray-500 transition hover:text-white"
          >
            Forgot password?
          </button>

        </div>

        <!-- Submit -->

        <button
  type="submit"
  disabled={loading}
  className="mt-6 flex h-11 w-full items-center justify-center rounded-xl bg-[#B71C1C] text-[15px] font-semibold text-white transition hover:bg-[#991B1B] disabled:cursor-not-allowed disabled:opacity-60"
>
  {loading ? (
    <>
      <svg
        className="mr-2 h-4 w-4 animate-spin"
        viewBox="0 0 24 24"
        fill="none"
      >
        <circle
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          strokeWidth="3"
          opacity=".25"
        />
        <path
          d="M22 12a10 10 0 0 1-10 10"
          stroke="currentColor"
          strokeWidth="3"
        />
      </svg>

      Please wait...
    </>
  ) : (
    mode === "signin"
      ? "Sign In"
      : "Create Account"
  )}
</button>

        <!-- Message -->

        <p
          id="message"
          class="mt-4 text-center text-sm text-gray-400"
        ></p>

        <!-- Footer -->

        <p class="mt-6 text-center text-[12px] leading-6 text-gray-500">

          By continuing you agree to our

          <a
            href="/terms"
            class="text-white transition hover:text-[#B71C1C]"
          >
            Terms
          </a>

          and

          <a
            href="/privacy"
            class="text-white transition hover:text-[#B71C1C]"
          >
            Privacy Policy
          </a>.

        </p>

      </div>

    </div>

  </div>

</div>

<script type="module">

import { supabase } from "../lib/supabase";

document.addEventListener("DOMContentLoaded", () => {

  // tutto il codice...

});

</script>