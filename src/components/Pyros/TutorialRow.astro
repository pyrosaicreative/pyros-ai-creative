---
import TutorialCard from './TutorialCard.astro';

interface Props {
  title: string;
  tutorials: any[];
}

const { title, tutorials } = Astro.props;

const rowId = `tutorial-row-${title
  .replace(/[^\w\s]/g, '')
  .replace(/\s+/g, '-')
  .toLowerCase()}`;
---

<div class="mb-16">

  <!-- Header -->
  <div class="mb-5 flex items-center justify-between">

    <h2 class="text-3xl font-bold text-white">
      {title}
    </h2>

    <!-- Navigation -->
    <div class="flex items-center gap-2">

      <button
        type="button"
        aria-label="Previous tutorials"
        data-direction="left"
        data-target={rowId}
        class="group flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-[#111111] text-white/70 transition-all duration-300 hover:border-[#B08A57]/60 hover:bg-[#181818] hover:text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-5 w-5 transition-transform duration-300 group-hover:-translate-x-0.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <button
        type="button"
        aria-label="Next tutorials"
        data-direction="right"
        data-target={rowId}
        class="group flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-[#111111] text-white/70 transition-all duration-300 hover:border-[#B08A57]/60 hover:bg-[#181818] hover:text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Cards -->
  <div
    id={rowId}
    class="tutorial-scroll flex gap-6 overflow-x-auto px-2 py-4 scroll-smooth"
    style="scrollbar-width: none;"
  >

    {
      tutorials.map((tutorial) => (
        <div class="w-[340px] min-w-[340px]">
          <TutorialCard
            title={tutorial.title}
            image={tutorial.thumbnail}
            href={`/tutorials/${tutorial.slug}`}
            badge={tutorial.badge}
          />
        </div>
      ))
    }

  </div>

</div>

<style>
  .tutorial-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>('button[data-direction]');

    if (!button) return;

    const rowId = button.dataset.target;
    const direction = button.dataset.direction;

    if (!rowId || !direction) return;

    const row = document.getElementById(rowId);

    if (!row) return;

    const amount = 364;

    row.scrollBy({
      left: direction === 'left' ? -amount : amount,
      behavior: 'smooth',
    });
  });
</script>