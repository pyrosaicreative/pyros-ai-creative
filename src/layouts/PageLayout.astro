---
import DesignHeader from '~/components/Redesign/Header.astro';
import DesignFooter from '~/components/Redesign/Footer.astro';
import '~/assets/styles/redesign.css';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/Pyros/Footer.astro';
import CookieConsent from '~/components/Pyros/CookieConsent.astro';

import { headerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <div class:list={{ 'pyros-site': !Astro.url.pathname.startsWith('/pyros-connect') }}>
    {
      Astro.url.pathname.startsWith('/pyros-connect') ? (
        <Header {...headerData} isSticky showRssFeed showToggleTheme />
      ) : (
        <DesignHeader />
      )
    }
    <main><slot /></main>
    {Astro.url.pathname.startsWith('/pyros-connect') ? <Footer /> : <DesignFooter />}
  </div>
  <CookieConsent />
</Layout>
